# ReliabilityX — Environment Configuration Template
# Copy to .env and customize for your deployment environment.
# DO NOT commit real secrets or credentials to source control.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS Configuration
# Comma-separated list of allowed origins. Set exact origins for production deployment.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173

# Database Configuration
DATABASE_PATH=reliabilityx.db

# Live Telemetry & Streaming Configuration
DEFAULT_SAMPLING_RATE_SECONDS=0.8
MAX_TELEMETRY_BUFFER_SIZE=500
ENABLE_MQTT_ADAPTER=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=reliabilityx/telemetry

# AI Model & Screening Pipeline Configuration
MODEL_VERSION=v1.4.0
DPAT_K_FACTOR=3.0
Z_SCORE_THRESHOLD=3.0
DEFAULT_PREDICTION_MODEL=PHYSICS_INFORMED_ARRHENIUS
