{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.cjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reliabilityx-backend.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://reliabilityx-backend.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://reliabilityx-backend.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
