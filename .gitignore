# ==============================================================================
# ReliabilityX — Git Ignore Specification
# ==============================================================================

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Database & Runtime State
*.db
*.sqlite
*.sqlite3
!backend/data/seed_benchmark.db
server.log
*.log

# Environment & Secrets (Keep .env.example tracked)
.env
.env.local
.env.*.local
!.env.example

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Node / Web Build Caches (Bundles are built from frontend/static/app.tsx)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/
dist/

# Internal Reports
*REPORT*.md

